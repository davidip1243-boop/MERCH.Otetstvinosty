{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1.js"
    },
    {
      "src": "/catalog",
      "dest": "/catalog/index.html"
    },
    {
      "src": "/about",
      "dest": "/about/index.html"
    },
    {
      "src": "/cart",
      "dest": "/cart/index.html"
    },
    {
      "src": "/item/tee-team",
      "dest": "/item/tee-team/index.html"
    },
    {
      "src": "/item/(tee-white|tee-graphite|tee-banana|tee-light-brown|tee-light-grey|tee-burgundy|hoodie-road|longsleeve-light|tote-dream)",
      "dest": "/item/tee-team/index.html"
    },
    {
      "handle": "filesystem"
    }
  ],
  "name": "orthodox-merch-shop"
}
